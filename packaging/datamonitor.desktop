[Desktop Entry]
Version=1.0
Type=Application
Name=Data Monitor
GenericName=Internet data usage monitor
Comment=Track download and upload totals, live speeds, data quotas and per-app usage
Exec=@EXEC@
Icon=datamonitor
Terminal=false
